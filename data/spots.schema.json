{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-hour-dallas.local/spots.schema.json",
  "title": "Golden Hour Dallas spots",
  "description": "GeoJSON FeatureCollection of sunrise/sunset viewing spots. Coordinates are [lng, lat].",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/spotFeature" }
    },
    "_note": {
      "type": "string",
      "description": "Vendor member. Not part of GeoJSON Feature properties."
    }
  },
  "$defs": {
    "viewQuality": {
      "type": "string",
      "enum": ["open", "partial", "blocked", "unknown"]
    },
    "spotFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": { "$ref": "#/$defs/point" },
        "properties": { "$ref": "#/$defs/spotProperties" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "number", "description": "longitude" },
            { "type": "number", "description": "latitude" }
          ]
        }
      }
    },
    "spotProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "best_for",
        "tags",
        "description",
        "access",
        "hours_note",
        "parking_note",
        "facing",
        "horizon_score",
        "sources",
        "mention_count",
        "verified",
        "last_updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable slug, e.g. reunion-tower"
        },
        "name": { "type": "string", "minLength": 1 },
        "best_for": { "type": "string", "enum": ["sunrise", "sunset", "both"] },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "rooftop",
              "park",
              "lake",
              "bridge",
              "garage",
              "overlook",
              "trail",
              "pier",
              "plaza"
            ]
          }
        },
        "description": { "type": "string", "minLength": 1 },
        "access": {
          "type": "string",
          "enum": ["public_free", "public_paid", "restricted", "unknown"]
        },
        "hours_note": { "type": ["string", "null"] },
        "parking_note": { "type": ["string", "null"] },
        "facing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sunrise_view", "sunset_view"],
          "properties": {
            "sunrise_view": { "$ref": "#/$defs/viewQuality" },
            "sunset_view": { "$ref": "#/$defs/viewQuality" }
          }
        },
        "horizon_score": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sunrise", "sunset"],
              "properties": {
                "sunrise": { "type": "number", "minimum": 0, "maximum": 1 },
                "sunset": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "kind", "retrieved_at"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "kind": { "type": "string", "enum": ["osm", "web", "reddit", "manual"] },
              "retrieved_at": { "type": "string", "format": "date" }
            }
          }
        },
        "mention_count": { "type": "integer", "minimum": 1 },
        "verified": { "type": "boolean" },
        "last_updated": { "type": "string", "format": "date" }
      }
    }
  }
}
